# Copy to .env for local development. .env is gitignored; this file is not.

# REQUIRED. Shared bearer token for every /mcp request. The server crashes at boot
# if this is unset — there is deliberately no default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_BEARER_TOKEN=

# HTTP port. Railway injects this automatically in production.
PORT=3000

# SQLite file. Dropped and reseeded on every boot, so its contents are disposable.
# ':memory:' is valid and is what the test suite uses.
DB_PATH=./commerce.db

# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Compatibility fallback — DEMO USE ONLY, leave false by default.
# When true, mounts POST /mcp/<token> so clients that cannot set an Authorization
# header can still connect. Claude's `static_headers` auth is Beta and gated behind
# an org-administrator flow, so header auth is not guaranteed to be available.
# Credentials in URLs are weaker than in headers (they reach proxy logs, browser
# history, and Referer) — see CONVENTIONS.md A2.5. When unset, the route does not
# exist at all and returns 404.
ALLOW_URL_TOKEN=false
